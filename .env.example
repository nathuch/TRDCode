# Configuración de TRDCode. Copiar como .env y completar con los datos reales.
# El .env no va al repositorio. En producción, dejarlo fuera de la carpeta pública
# e indicar su ruta en la variable de entorno TRDCODE_ENV.

DB_HOST=localhost
DB_NAME=trdcode
DB_USER=trdcode_app
DB_PASS=

# Si está activa, la API no envía el nombre de los expedientes IPC e IPR.
# Solo se desactiva (false) si el SENA lo autoriza.
OCULTAR_NOMBRES_RESERVADOS=true
