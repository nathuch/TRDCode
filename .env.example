# Configuración de TRDCode. Copiar y completar con los datos reales.
# Nunca va al repositorio ni a la carpeta pública. En el servidor se copia junto a la
# carpeta pública con el nombre de la carpeta de la aplicación (con la aplicación en
# C:\xampp\htdocs\TRDCode, queda en C:\xampp\TRDCode.env), o en la ruta que indique
# la variable de entorno TRDCODE_ENV.

DB_HOST=localhost
DB_NAME=trdcode
DB_USER=trdcode_app
DB_PASS=

# Si está activa, la API no envía el nombre de los expedientes IPC e IPR.
# Solo se desactiva (false) si el SENA lo autoriza.
OCULTAR_NOMBRES_RESERVADOS=true
